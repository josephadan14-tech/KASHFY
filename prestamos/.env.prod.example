# Copia este archivo como .env.prod EN EL SERVIDOR y completa los valores.
# NUNCA lo subas a internet ni lo compartas.

# Tu dirección (sin https://). Ejemplo: cobros.miempresa.com
# Para ensayar en tu propia PC usa: localhost
DOMINIO=cobros.miempresa.com
# Correo para los avisos del certificado HTTPS
EMAIL_ADMIN=tu@correo.com

# Base de datos. Usa SOLO letras y números en la clave (sin símbolos).
DB_USUARIO=prestamos
DB_NOMBRE=prestamos
# Genera una con:  openssl rand -hex 24
DB_CLAVE=cambia-esto

# Firma de las sesiones (mínimo 32 caracteres). Genera una con:  openssl rand -hex 48
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
