# Copia este archivo como .env y ajusta los valores
DATABASE_URL=postgres://prestamos:prestamos_dev@127.0.0.1:5434/prestamos
PORT=3000
# Clave para firmar los tokens de sesión (mínimo 32 caracteres, secreta, distinta en producción).
# Genérala con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria-de-32-o-mas
